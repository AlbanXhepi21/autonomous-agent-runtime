OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Model prices are versioned in app/llm/pricing.py. The response model is used
# for each estimate, so snapshots automatically receive their base model price.
MAX_AGENT_ITERATIONS=8
MAX_AGENT_TOOL_CALLS=16
MAX_AGENT_RECOVERABLE_ERRORS=3
MAX_AGENT_CONSECUTIVE_DUPLICATE_ACTIONS=2
MAX_PARALLEL_SUBAGENTS=3
MAX_DELEGATIONS_PER_RUN=8
MAX_SUBAGENT_ITERATIONS=6
MAX_AGENT_DEPTH=1
AGENT_WORKSPACE_ROOT=./var
MAX_FILE_READ_BYTES=65536
MAX_FILE_WRITE_BYTES=65536
MAX_LIST_FILES=100
COMMAND_ALLOWLIST=pytest
COMMAND_TIMEOUT_SECONDS=15
MAX_COMMAND_OUTPUT_BYTES=16384
PYTHON_EXEC_TIMEOUT_SECONDS=10
MAX_PYTHON_CODE_BYTES=16384
MAX_PYTHON_OUTPUT_BYTES=16384
MAX_ARTIFACT_BYTES=10485760
PYTHON_EXEC_ALLOWED_IMPORTS=math,statistics,json,datetime,collections
SUMMARY_TRIGGER_OBSERVATIONS=8
RECENT_OBSERVATIONS=5
MEMORY_BACKEND=in_memory
# `in_memory` loses every artifact record when the process stops, leaving files
# on disk that nothing can hand out. `postgres` keeps the record beside the bytes
# so a download link survives a restart.
ARTIFACT_BACKEND=in_memory
DATABASE_URL=
# Conversation history and artifact records use this same runtime database. Apply
# `alembic upgrade head` before starting the API; agent memory remains
# independently configurable above.
# External, read-only analytics source. Do not reuse DATABASE_URL unless intentional.
ANALYTICS_DATABASE_URL=
ANALYTICS_DB_SCHEMA=public
ANALYTICS_SCHEMA_CACHE_TTL_SECONDS=300
ANALYTICS_MAX_RESULT_ROWS=5000
ANALYTICS_MAX_RESULT_BYTES=1000000
ANALYTICS_QUERY_TIMEOUT_SECONDS=15
ANALYTICS_PYTHON_MAX_DATASET_ROWS=1000
ANALYTICS_PYTHON_MAX_DATASET_BYTES=500000
ANALYTICS_PYTHON_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
LOG_FORMAT=pretty
# Comma-separated trusted local Workbench origins; never defaults to wildcard CORS.
ANALYTICS_UI_FRONTEND_ORIGINS=http://localhost:3000
# SQL is retained only for successful, bounded developer traces when enabled.
ANALYTICS_UI_EXPOSE_SQL=false
ANALYTICS_UI_MAX_SQL_CHARS=4000
WORKBENCH_DEVELOPER_MODE=false
