{
  "name": "quarterly_review",
  "version": "3",
  "title": "Quarterly Performance Report",
  "description": "A quarter's performance with trend charts, supporting detail and a full evidence appendix, for a stakeholder review pack.",
  "report_type": "executive",
  "period_granularity": "quarter",
  "orientation": "portrait",
  "formats": [
    "pdf",
    "docx"
  ],
  "blocks": [
    {
      "kind": "cover"
    },
    {
      "kind": "scope",
      "heading": "Reporting Scope",
      "required": true
    },
    {
      "kind": "narrative",
      "heading": "Executive Summary",
      "required": true
    },
    {
      "kind": "metrics",
      "heading": "Headline Metrics",
      "required": true,
      "limit": 8
    },
    {
      "kind": "chart",
      "heading": "Charts",
      "required": true,
      "limit": 6
    },
    {
      "kind": "table",
      "heading": "Supporting Tables",
      "required": true,
      "limit": 6
    },
    {
      "kind": "caveats",
      "heading": "Limitations",
      "required": true
    },
    {
      "kind": "page_break"
    },
    {
      "kind": "evidence",
      "heading": "Evidence Appendix",
      "required": true
    }
  ]
}
