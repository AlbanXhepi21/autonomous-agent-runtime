{
  "name": "analysis_summary",
  "version": "4",
  "title": "Analysis Summary",
  "description": "A single investigation written up as a shareable document, whatever period it covered.",
  "report_type": "executive",
  "period_granularity": "custom",
  "orientation": "portrait",
  "formats": [
    "pdf",
    "docx"
  ],
  "blocks": [
    {
      "kind": "cover"
    },
    {
      "kind": "scope",
      "heading": "Reporting Scope",
      "required": true
    },
    {
      "kind": "narrative",
      "heading": "Executive Summary",
      "required": true
    },
    {
      "kind": "metrics",
      "heading": "Headline Metrics"
    },
    {
      "kind": "chart",
      "heading": "Charts",
      "limit": 6
    },
    {
      "kind": "table",
      "heading": "Supporting Tables",
      "limit": 6
    },
    {
      "kind": "caveats",
      "heading": "Limitations",
      "required": true
    },
    {
      "kind": "evidence",
      "heading": "Evidence Appendix",
      "required": true
    }
  ],
  "slots": [
    {
      "id": "key_metrics",
      "accepts": ["kpi"],
      "minimum": 0,
      "maximum": 6,
      "required": false,
      "role": "primary"
    },
    {
      "id": "supporting_charts",
      "accepts": ["line", "area", "bar", "stacked_bar", "pie", "scatter"],
      "minimum": 0,
      "maximum": 6,
      "required": false,
      "role": "supporting"
    },
    {
      "id": "supporting_tables",
      "accepts": ["table"],
      "minimum": 0,
      "maximum": 6,
      "required": false,
      "role": "supporting"
    }
  ]
}
