{
  "name": "executive_dashboard",
  "version": "3",
  "title": "Executive Dashboard",
  "description": "A one-page landscape summary: headline cards, the principal charts and little else, with the full evidence kept behind it.",
  "report_type": "executive",
  "period_granularity": "custom",
  "orientation": "landscape",
  "formats": [
    "pdf",
    "docx"
  ],
  "blocks": [
    {
      "kind": "cover"
    },
    {
      "kind": "metrics",
      "heading": "Headline Metrics",
      "required": true,
      "limit": 6
    },
    {
      "kind": "chart",
      "heading": "Charts",
      "required": true,
      "limit": 4
    },
    {
      "kind": "narrative",
      "heading": "Executive Summary",
      "required": false
    },
    {
      "kind": "caveats",
      "heading": "Limitations",
      "required": true
    },
    {
      "kind": "page_break"
    },
    {
      "kind": "scope",
      "heading": "Reporting Scope",
      "required": true
    },
    {
      "kind": "table",
      "heading": "Supporting Tables",
      "required": false,
      "limit": 8
    },
    {
      "kind": "evidence",
      "heading": "Evidence Appendix",
      "required": true
    }
  ],
  "slots": [
    {
      "id": "headline_metrics",
      "accepts": ["kpi"],
      "minimum": 3,
      "maximum": 6,
      "required": true,
      "role": "primary",
      "purpose_hint": "headline"
    },
    {
      "id": "primary_trend",
      "accepts": ["line", "area"],
      "minimum": 0,
      "maximum": 1,
      "required": false,
      "role": "primary",
      "purpose_hint": "trend"
    },
    {
      "id": "primary_breakdown",
      "accepts": ["bar", "stacked_bar"],
      "minimum": 1,
      "maximum": 1,
      "required": true,
      "role": "primary",
      "purpose_hint": "breakdown"
    },
    {
      "id": "secondary_breakdown",
      "accepts": ["bar", "stacked_bar", "pie", "scatter"],
      "minimum": 0,
      "maximum": 2,
      "required": false,
      "role": "supporting"
    },
    {
      "id": "supporting_table",
      "accepts": ["table"],
      "minimum": 0,
      "maximum": 2,
      "required": false,
      "role": "supporting"
    }
  ]
}
