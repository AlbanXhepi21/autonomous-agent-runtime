{
  "name": "annual_review",
  "version": "4",
  "title": "Annual Business Report",
  "description": "A full year of performance with trend charts and the queries behind every figure.",
  "report_type": "executive",
  "period_granularity": "year",
  "orientation": "portrait",
  "formats": [
    "pdf",
    "docx"
  ],
  "blocks": [
    {
      "kind": "cover"
    },
    {
      "kind": "scope",
      "heading": "Reporting Scope",
      "required": true
    },
    {
      "kind": "narrative",
      "heading": "Executive Summary",
      "required": true
    },
    {
      "kind": "metrics",
      "heading": "Headline Metrics",
      "required": true,
      "limit": 8
    },
    {
      "kind": "chart",
      "heading": "Charts",
      "required": true,
      "limit": 6
    },
    {
      "kind": "table",
      "heading": "Supporting Tables",
      "required": true,
      "limit": 6
    },
    {
      "kind": "caveats",
      "heading": "Limitations",
      "required": true
    },
    {
      "kind": "page_break"
    },
    {
      "kind": "evidence",
      "heading": "Evidence Appendix",
      "required": true
    }
  ],
  "slots": [
    {
      "id": "headline_metrics",
      "accepts": ["kpi"],
      "minimum": 3,
      "maximum": 8,
      "required": true,
      "role": "primary",
      "purpose_hint": "headline"
    },
    {
      "id": "primary_trend",
      "accepts": ["line", "area"],
      "minimum": 1,
      "maximum": 2,
      "required": true,
      "role": "primary",
      "purpose_hint": "trend"
    },
    {
      "id": "key_breakdowns",
      "accepts": ["bar", "stacked_bar", "pie", "scatter"],
      "minimum": 0,
      "maximum": 4,
      "required": false,
      "role": "primary",
      "purpose_hint": "breakdown"
    },
    {
      "id": "supporting_tables",
      "accepts": ["table"],
      "minimum": 1,
      "maximum": 6,
      "required": true,
      "role": "supporting"
    }
  ]
}
